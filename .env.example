# ── Obligatorias ──────────────────────────────────────────────────────────────
# Defínelas también en Vercel (Settings → Environment Variables → Production).
# Genera cada secreto con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Cadena de conexión de MongoDB Atlas
MONGODB_URI="mongodb+srv://usuario:contraseña@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority"

# Firma de las cookies de sesión
SESSION_SECRET="genera_un_valor_aleatorio_de_64_caracteres_hex"

# Cifrado AES-256-GCM de los RUT (64 caracteres hexadecimales).
# Si se cambia, los RUT ya guardados dejan de poder descifrarse.
DATA_ENCRYPTION_KEY="genera_un_valor_aleatorio_de_64_caracteres_hex"

# Blind index HMAC de los RUT para el login. Si se cambia, hay que recalcular rutHash.
HMAC_SECRET="genera_un_valor_aleatorio_de_64_caracteres_hex"

# ── Opcionales ────────────────────────────────────────────────────────────────

# APP_URL: The URL where this applet is hosted.
APP_URL="https://trayectoria-estudiantil-uft.vercel.app"

# Configuración del Servidor de Correo (Google SMTP)
# Para Gmail se utiliza una "Contraseña de aplicación" (App Password de 16 letras)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="tu_correo@gmail.com"
SMTP_PASS="tu_contraseña_de_aplicacion_16_caracteres"
SMTP_FROM_NAME="Trayectoria Estudiantil UFT"
